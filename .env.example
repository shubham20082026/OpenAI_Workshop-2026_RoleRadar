# Server-only configuration. Copy to .env; do not commit .env or real values.
# No variable is prefixed VITE_; no Supabase key is bundled into the browser.
APP_URL=http://127.0.0.1:5173
PORT=3001
NODE_ENV=development
SERVE_FRONTEND=false

# From the Supabase project Connect/API settings. Leave empty for guest/demo only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Recommended deletion: deploy the included authenticated Supabase Edge Function.
# Privileged keys stay in the Edge runtime; no local admin key is needed.
SUPABASE_DELETE_FUNCTION=delete-scamlens-account

# Optional legacy fallback ONLY if the Edge Function is not used:
# SUPABASE_SERVICE_ROLE_KEY=
# Never use an admin key in ordinary RLS-scoped queries or send it to the client.

# Legacy projects may set SUPABASE_ANON_KEY instead of PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=

# Optional free Himalayas read-only key for higher source quotas. Never use VITE_*.
HIMALAYAS_API_KEY=
